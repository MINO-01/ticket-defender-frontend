{
  "realm": "ticket-defender-demo",
  "displayName": "Ticket Defender capstone demo (synthetic data only)",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "ticket-defender-web",
      "name": "Ticket Defender Web (capstone)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:15173/app/overview"],
      "webOrigins": ["http://localhost:15173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:15173/",
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "ticket-defender-admin-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticket-defender-admin",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
