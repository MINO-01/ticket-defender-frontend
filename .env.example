# 격리된 합성 데이터 시연 환경에서만 설정한다. 운영 공연 UUID나 비밀값을 커밋하지 않는다.
# 서버에 등록되고 공개 제보가 허용된 공연 UUID. 비어 있거나 형식이 잘못되면 실제 제출이 비활성화된다.
VITE_FAN_REPORT_EVENT_ID=
# 작성 화면에 표시할 공연 이름(선택)
VITE_FAN_REPORT_EVENT_LABEL=
# 관리자 인증 공개 설정. client secret 등 비밀값은 넣지 않는다. 세 값이 모두 없으면 관리자 화면이 차단되고,
# 일부만 있거나 issuer가 HTTPS가 아니면 설정 오류로 차단된다. 인증 제공자가 확정되기 전에는 값이 있어도 로그인은 비활성이다.
VITE_ADMIN_AUTH_ISSUER=
VITE_ADMIN_AUTH_CLIENT_ID=
VITE_ADMIN_AUTH_AUDIENCE=
# 개발 서버(npm run dev)에서만 합성 데이터 관리자 화면 미리보기를 켠다(true). 인증 세션이 아니며 운영 빌드에서는 무시된다.
VITE_ADMIN_DEMO_PREVIEW=
# 개발 서버 전용 Backend 프록시 대상(예: http://localhost:8080). 빌드 결과물에는 포함되지 않는다.
TD_DEV_API_PROXY_TARGET=
